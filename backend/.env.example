PORT = 8080
MONGODB_URI = YOUR_MONGODB_BASE_URI/database_name
JWT_SECRET = RANDOM_STRING
CLOUD_NAME = CLOUDINARY_CLOUD_NAME
CLOUD_API_KEY = CLOUDINARY_API_KEY
CLOUD_SECRET = CLOUDINARY_SECRET_KEY
STRIPE_SECRET_KEY= YOUR_STRIPE_SECRET_KEY
HDFC_SMARTGATEWAY_BASE_URL=https://smartgateway.hdfcuat.bank.in
HDFC_API_KEY=
HDFC_RESPONSE_KEY=
HDFC_CARD_ENCODING_KEY=
HDFC_MERCHANT_ID=
HDFC_PAYMENT_PAGE_CLIENT_ID=hdfcmaster
# On UAT, dummy CHARGED payments create orders by default. For security audit / prod parity set false.
HDFC_UAT_ALLOW_DUMMY=true
FRONTEND_URL=https://corpculture.in,http://localhost:5173
# Used only if app return_url is rejected by gateway. Prefer shopper origin on UAT.
HDFC_RETURN_URL=https://corpculture.in/shipping/payment-return
# Create under SmartGateway Settings > Security, then enable "Use signed response".
# HDFC_RESPONSE_KEY is required for return URL HMAC validation during audit.